---
// Credit: https://cassidysmith.dev/posts/modify-astro-slot-children
let html = await Astro.slots.render('default')
html = html.replaceAll("@@", "<ruby class='stressed-syllable'>").replaceAll("::", "<rt>/</rt></ruby>");
html = html.replaceAll("///", "<ruby class='unstressed-syllable'>").replaceAll("/:/", "<rt>&cup;</rt></ruby>");
---
<blockquote class="amm-accented-poetry">
    <Fragment set:html={html} />
</blockquote>

<style>
    blockquote.amm-accented-poetry {
        font-style: normal;
        padding-left: calc(1em + 10px);
        text-indent: -1em;

        ruby.stressed-syllable {
            font-style: oblique;
            font-weight: 500;
        }

        rt {
            font-weight: 900;
            font-size: .67em;
        }
    }
</style>