---
import Social from './Social.astro';
import Divider from "@components/Divider.astro";
import NavigationLink from "@components/Navigation/NavigationLink.astro";
const platform = "github";
const username = "withastro";
---
<footer>
    <div class="footer-container">
        <div>
            &copy; {new Date().getFullYear()} Aaron Morey
        </div>
        <div>
            <a href="/about/colophon/">Colophon</a>
        </div>
        <div>
            <a href="/about/blogroll/">Blogroll</a>
        </div>
    </div>
    <!--<button id="theme-toggle" style="display:none;">Toggle Theme</button>-->
</footer>

<style>
    .footer-container {
        margin-top: 75px;
        margin-bottom: 50px;
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 1.5rem;
        font-size: .85rem;
        color: var(--medium-grey);
    }

    .footer-container > a {
        font-size: .25rem;
        color: var(--medium-grey) !important;
    }
</style>