---
import {runSqliteQuery, QUERIES} from "@utils/db-operations.ts";
import {formatCenturyForEra} from "@utils/utils.ts";
const centuryDate: Array<object> = await runSqliteQuery(QUERIES.BOOKS_BY_CENTURY_AGGREGATE);
---
<table>
    <thead>
        <tr>
            <td>
                Century
            </td>
            <td>
                Books Read
            </td>
        </tr>
    </thead>
    <tbody>
    {
        centuryDate.map(
            function(centuryRow, i: number) {
                let style = i % 2 == 0 ? 'even' : 'odd';
                return (
                    <tr class={style}>
                        <td>
                            <a href=`/reading/century/${centuryRow.century}`>
                                {formatCenturyForEra(centuryRow.century)}
                            </a>
                        </td>
                        <td>{centuryRow.total_books}</td>
                    </tr>
                )
            }
        )
    }
    </tbody>
</table>
