---
export interface Props {
    pageTitle: string,
    excludeFromStaticSearch: boolean,
    indexStatus: string,
    pageTitleIsH1: boolean
}

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const { pageTitle, excludeFromStaticSearch, indexStatus, pageTitleIsH1 = true } = Astro.props;
import bookAndLaptop from '@assets/images/BookAndLaptopBitmoji.png';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

---
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="/fonts/Vollkorn-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="/fonts/Vollkorn-Italic-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="/fonts/OldStandardTT-Regular.ttf" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="/fonts/OldStandardTT-Italic.ttf" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="/fonts/OldStandardTT-Bold.ttf" as="font" type="font/ttf" crossorigin>
    <!-- Font Awesome -->
    <link href="/fontawesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="/fontawesome/css/brands.min.css" rel="stylesheet" />
    <link href="/fontawesome/css/solid.min.css" rel="stylesheet" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Make Meta pages discoverable -->
    <link
            rel="alternate"
            type="application/rss+xml"
            title="Aaron Morey Dot Com"
            href={new URL("feed.xml", Astro.site)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AaronMorey.com" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- OG Image -->
    <meta property="og:image" content={Astro.site + bookAndLaptop.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="AaronMorey.com" />
    <meta property="og:image:width" content="398"/>
    <meta property="og:image:height" content="398"/>
    <meta property="og:locale" content="en_US"/>

    <!-- PageFind -->
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet">
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>

    <script>
        (function() {
            // Prevent flash of unstyled color theme
            // Check localStorage or system preference
            const storedTheme = localStorage.getItem('theme');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            // Apply theme: stored preference > system preference
            if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    {
        indexStatus
            ? <meta name="robots" content={indexStatus} />
            : ""
    }

    <title>{pageTitle}</title>
</head>
<body class="flex flex-col min-h-screen">
<Header />
<main class="flex-1 mx-auto px-4 sm:px-6 lg:px-8 py-8"
    {...(excludeFromStaticSearch ? {} : { 'data-pagefind-body': '' })}
>
    {
            pageTitleIsH1 ? <h1 class="sign-painted">{pageTitle}</h1> : ""
    }
    <slot />
</main>
<Footer />
<script>
    import initTheme from "../scripts/theme-switcher.js";
    initTheme();
</script>
</body>
</html>