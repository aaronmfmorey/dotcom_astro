---
import {Image} from "astro:assets";
import BaseLayout from '@layouts/BaseLayout.astro';
import engravedHeadShot from '../assets/images/AaronHeadshotEngraved.png';
import AboutLinks from "@components/AboutLinks.astro";
const pageTitle = "Aaron Morey";
---
<BaseLayout pageTitle={pageTitle} pageTitleIsH1={false} >
	<h1 class="hero-header">Aaron Morey</h1>
	<h2>About Me</h2>
	<div class="flex w-full justify-center">
		<Image src={engravedHeadShot} alt="A headshot of me" class="big-headshot"></Image>
	</div>
	<p>
		I'm a <span><code>web developer <span class="cursor">▉</span></code></span>  in the Milwaukee area, working as a software development manager.
	</p>
	<p>I have over fifteen years experience across multiple industries including
		insurance, finance, marketing, and warehousing/logistics. I believe in good code, customer service, strong
		communication, and the Oxford comma.
	</p>
	<AboutLinks/>
</BaseLayout>
<style>
	span > code::before {
		content: "> ";
		font-weight: 800;
	}

	.cursor {
		animation: blink 1.25s infinite;
		animation-fill-mode: both;
	}

	@keyframes blink {
		0% { opacity: 0 }
		50% { opacity: 1 }
		100% { opacity: 0 }
	}

	.hero-header {
		font-weight: 800;
		font-size: clamp(2rem, 15cqw, 5.5rem);
	}

	.big-headshot {
		width: clamp(10px, 50%, 300px);
		aspect-ratio: 1 / 1;
		object-fit: contain;
		border: 5px solid var(--near-black);
		border-radius: 50%;
		border-style: double;
		background-color: var(--light-grey);
	}
</style>